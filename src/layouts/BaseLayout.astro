---
import '../styles/global.css';
import archivoUrl from '../fonts/archivo-var-latin.woff2?url';
import plexMono400Url from '../fonts/plex-mono-400-latin.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  /** Absolute-ready path for og:image; defaults to the generated card. */
  ogImage?: string;
  /** JSON-LD object, rendered as-is when provided. */
  jsonLd?: Record<string, unknown>;
  /** Set on /admin so crawlers keep out. */
  noindex?: boolean;
}

const { title, description, ogImage, jsonLd, noindex = false } = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage ?? withBase('/og-default.png'), site);
const jsonLdSafe = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="en" data-theme="dark" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400Url} as="font" type="font/woff2" crossorigin />

    {jsonLdSafe && <script is:inline type="application/ld+json" set:html={jsonLdSafe} />}

    <script is:inline>
      // Theme before first paint: stored choice wins, else system preference.
      (function () {
        document.documentElement.classList.remove('no-js');
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveals: one fade-and-rise per element, triggered once.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (els.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            // elements entering in the same batch stagger by 40ms, capped
            let i = 0;
            for (const e of entries) {
              if (e.isIntersecting) {
                const el = e.target as HTMLElement;
                el.style.transitionDelay = `${Math.min(i * 40, 160)}ms`;
                el.classList.add('is-in');
                io.unobserve(el);
                i += 1;
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        for (const el of els) io.observe(el);
      }
    </script>
  </body>
</html>
