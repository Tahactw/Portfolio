---
import { existsSync, readdirSync } from 'node:fs';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import archivoUrl from '../fonts/archivo-var-latin.woff2?url';
import plexMono400Url from '../fonts/plex-mono-400-latin.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  /** Absolute-ready path for og:image; defaults to the generated card. */
  ogImage?: string;
  /** JSON-LD object, rendered as-is when provided. */
  jsonLd?: Record<string, unknown>;
  /** Set on /admin so crawlers keep out. */
  noindex?: boolean;
}

const { title, description, ogImage, jsonLd, noindex = false } = Astro.props;

/* B3 asset override: woff2 files named display*.woff2 in public/fonts/
   become the display face, silently. Bold in the filename maps to 700. */
let displayFonts: { href: string; weight: number }[] = [];
try {
  displayFonts = readdirSync('public/fonts')
    .filter((f) => /^display.*\.woff2$/i.test(f))
    .slice(0, 4)
    .map((f) => ({
      href: withBase(`/fonts/${f}`),
      weight: /bold|700/i.test(f) ? 700 : /medium|500/i.test(f) ? 500 : 400,
    }));
} catch {
  /* no public/fonts dir: generated (Archivo) stays */
}

/* B5 asset override: ambient sound appears only when the file exists.
   Muted by default, one obvious toggle, remembered per device. */
const ambienceFile = existsSync('public/media/audio/ambience.mp3');
const ambienceHref = withBase('/media/audio/ambience.mp3');

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage ?? withBase('/og-default.png'), site);
const jsonLdSafe = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="en" data-theme="dark" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400Url} as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    {displayFonts.length > 0 && (
      <style
        set:html={
          displayFonts
            .map(
              (f) =>
                `@font-face{font-family:'DisplayOverride';src:url('${f.href}') format('woff2');font-weight:${f.weight};font-display:swap;}`,
            )
            .join('') + `:root{--f-display:'DisplayOverride';}`
        }
      />
    )}

    {jsonLdSafe && <script is:inline type="application/ld+json" set:html={jsonLdSafe} />}

    <script is:inline>
      // Theme before first paint: stored choice wins, else system preference.
      // Re-applied after every client-side navigation swap.
      (function () {
        function applyTheme() {
          document.documentElement.classList.remove('no-js');
          var stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch (e) {}
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />

    {ambienceFile && (
      <button
        id="ambience-toggle"
        type="button"
        data-src={ambienceHref}
        aria-pressed="false"
        aria-label="Turn ambient sound on"
        class="no-print fixed bottom-4 right-4 z-30 mono text-[0.72rem] border border-line-strong bg-panel text-muted hover:text-text rounded px-3 py-2.5 min-h-[44px] transition-colors"
      >
        Sound: off
      </button>
    )}

    <script>
      // Ambient sound: only if the owner supplied a file; never autoplays.
      function initAmbience() {
        const btn = document.getElementById('ambience-toggle');
        if (!btn || btn.dataset.wired) return;
        btn.dataset.wired = '1';
        let audio: HTMLAudioElement | null = null;
        let on = false;
        const label = () => {
          btn.textContent = on ? 'Sound: on' : 'Sound: off';
          btn.setAttribute('aria-pressed', String(on));
          btn.setAttribute('aria-label', on ? 'Turn ambient sound off' : 'Turn ambient sound on');
        };
        btn.addEventListener('click', () => {
          on = !on;
          if (on) {
            if (!audio) {
              audio = new Audio(btn.dataset.src ?? '');
              audio.loop = true;
              audio.volume = 0.3;
            }
            void audio.play().catch(() => {
              on = false;
              label();
            });
          } else {
            audio?.pause();
          }
          try {
            localStorage.setItem('ambience-on', String(on));
          } catch { /* fine */ }
          label();
        });
        // remembered ON state still needs a tap to actually start (autoplay rules);
        // reflect the stored preference in the label only.
        label();
      }
      document.addEventListener('astro:page-load', initAmbience);
    </script>

    <script>
      // Scroll reveals: one fade-and-rise per element, triggered once.
      // Re-initialised after every client-side navigation.
      function initReveals() {
        const els = document.querySelectorAll<HTMLElement>('.reveal:not(.is-in)');
        if (els.length === 0) return;
        const io = new IntersectionObserver(
          (entries) => {
            // elements entering in the same batch stagger by 40ms, capped
            let i = 0;
            for (const e of entries) {
              if (e.isIntersecting) {
                const el = e.target as HTMLElement;
                el.style.transitionDelay = `${Math.min(i * 40, 160)}ms`;
                el.classList.add('is-in');
                io.unobserve(el);
                i += 1;
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        for (const el of els) io.observe(el);
      }
      document.addEventListener('astro:page-load', initReveals);
    </script>
  </body>
</html>
