---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CertCard from '../components/CertCard.astro';
import Vista from '../components/world/Vista.astro';
import EmptyState from '../components/EmptyState.astro';
import {
  profile,
  projects,
  featuredProjects,
  featuredCertificates,
  certificates,
  skillGroups,
  testimonials,
} from '../lib/content';
import { withBase } from '../lib/paths';

const heroProjects = featuredProjects.length > 0 ? featuredProjects : projects.slice(0, 3);

/* B1 asset override: drop public/media/models/hero.glb into the repo and a
   "on the bench today" 3D stage appears between the vista and the floor. */
const heroModel = existsSync('public/media/models/hero.glb');
const homeCerts = featuredCertificates.length > 0 ? featuredCertificates : certificates.slice(0, 3);

const site = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Mechatronics Engineer',
  description: profile.headline,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  url: site.href,
  sameAs: Object.values(profile.socials).filter(Boolean),
};
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.shortBio}
  jsonLd={jsonLd}
>
  <!-- Hero: the vista — an establishing shot over the maker-district -->
  <section class="hero-vista relative overflow-hidden">
    <Vista />
    <div class="wrap relative z-10 pt-[9vh] sm:pt-[12vh] pb-[38vh] sm:pb-[34vh]">
      <div class="max-w-2xl">
        <p class="hero-step eyebrow-sky">{profile.location} · {profile.availability}</p>
        <h1 class="hero-step display mt-4" style="font-size: var(--fs-display);">
          {profile.name}
        </h1>
        <p class="hero-step hero-headline text-[1.05rem] sm:text-[1.15rem] font-medium mt-4">
          {profile.headline}
        </p>
        <p class="hero-step hero-bio max-w-xl mt-5">{profile.shortBio}</p>
        <div class="hero-step flex flex-wrap gap-3 mt-9">
          <a
            href={withBase('/projects')}
            class="mono text-[0.85rem] bg-accent text-accent-ink rounded px-5 py-3 hover:opacity-90 transition-opacity duration-150 shadow-lg"
          >
            See the inventions
          </a>
          {
            profile.resumeFile ? (
              <a
                href={withBase(profile.resumeFile)}
                class="hero-btn-quiet mono text-[0.85rem] rounded px-5 py-3 transition-colors duration-150"
                target="_blank"
                rel="noopener noreferrer"
              >
                Résumé (PDF) ↗
              </a>
            ) : (
              <a
                href={withBase('/about')}
                class="hero-btn-quiet mono text-[0.85rem] rounded px-5 py-3 transition-colors duration-150"
              >
                Meet the inventor
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    heroModel && (
      <section class="wrap py-16 sm:py-20">
        <SectionHead eyebrow="On the bench today" title="The current build" />
        <div
          class="model-host border hairline rounded overflow-hidden relative bg-panel"
          data-model-host
          data-src={withBase('/media/models/hero.glb')}
          data-alt="The invention currently on the bench, in 3D"
        >
          <div class="relative flex flex-col items-center justify-center gap-3 min-h-[340px] p-6 text-center">
            <button
              type="button"
              data-load-model
              class="mono text-[0.8rem] bg-accent text-accent-ink rounded px-4 py-2.5 hover:opacity-90 transition-opacity duration-150"
            >
              Power it on
            </button>
            <p class="mono text-[0.68rem] text-muted">powers on when you tap · orbit with drag or arrow keys</p>
          </div>
        </div>
      </section>
    )
  }

  <!-- Selected work -->
  <section class:list={['wrap py-16 sm:py-20', heroModel && 'border-t hairline']}>
    <SectionHead
      eyebrow="Fresh from the bench"
      title="The inventions"
      moreHref={withBase('/projects')}
      moreLabel="Walk the floor"
    />
    {
      heroProjects.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {heroProjects.map((p, i) => (
            <ProjectCard project={p} eager={i === 0} />
          ))}
        </div>
      ) : (
        <EmptyState
          heading="The bench is clear"
          message="New inventions are on the drawing board. The first machines will be wheeled out here."
        />
      )
    }
  </section>

  <!-- Skills -->
  {
    skillGroups.length > 0 && (
      <section class="border-t hairline">
        <div class="wrap py-16 sm:py-20">
          <SectionHead eyebrow="Tools by trade" title="The workshop wall" />
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {skillGroups.map((g) => (
              <div class="reveal">
                <h3 class="mono text-[0.8rem] text-text uppercase tracking-widest border-b hairline pb-3">
                  {g.label}
                </h3>
                <ul class="flex flex-wrap gap-1.5 mt-4">
                  {g.skills.map((s) => (
                    <li class="mono text-[0.72rem] text-muted border hairline rounded px-2 py-0.5">
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Certificates -->
  {
    homeCerts.length > 0 && (
      <section class="border-t hairline">
        <div class="wrap py-16 sm:py-20">
          <SectionHead
            eyebrow="Stamped and mounted"
            title="The proving ground"
            moreHref={withBase('/certificates')}
            moreLabel="See the wall"
          />
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {homeCerts.slice(0, 3).map((c) => (
              <CertCard cert={c} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Testimonials -->
  {
    testimonials.length > 0 && (
      <section class="border-t hairline">
        <div class="wrap py-16 sm:py-20">
          <SectionHead eyebrow="Inspection notes" title="What the inspectors say" />
          <div class="grid md:grid-cols-2 gap-6 max-w-4xl">
            {testimonials.map((t) => (
              <figure class="reveal border-l-2 border-accent pl-5 py-1">
                <blockquote class="text-[0.98rem] leading-relaxed">“{t.quote}”</blockquote>
                <figcaption class="mono text-[0.75rem] text-muted mt-4">
                  {t.link ? (
                    <a href={t.link} target="_blank" rel="noopener noreferrer" class="hover:text-text underline-offset-4 hover:underline">
                      {t.author} ↗
                    </a>
                  ) : (
                    t.author
                  )}
                  {' — '}
                  {t.title}
                  {t.organisation ? `, ${t.organisation}` : ''}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Contact CTA -->
  <section class="border-t hairline" aria-labelledby="cta-heading">
    <div class="wrap py-16 sm:py-24 text-center">
      <p class="reveal eyebrow">Next operation</p>
      <h2 id="cta-heading" class="reveal h2 mt-3 max-w-xl mx-auto">
        Building something that has to work when nobody's watching it?
      </h2>
      <div class="reveal mt-8">
        <a
          href={withBase('/contact')}
          class="mono text-[0.85rem] bg-accent text-accent-ink rounded px-6 py-3.5 inline-block hover:opacity-90 transition-opacity duration-150"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { wireProjectMedia } from '../lib/media-wire';
  document.addEventListener('astro:page-load', () => wireProjectMedia());
</script>
