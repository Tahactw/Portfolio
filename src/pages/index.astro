---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CertCard from '../components/CertCard.astro';
import HeroFigure from '../components/HeroFigure.astro';
import EmptyState from '../components/EmptyState.astro';
import {
  profile,
  projects,
  featuredProjects,
  featuredCertificates,
  certificates,
  skillGroups,
  testimonials,
} from '../lib/content';
import { withBase } from '../lib/paths';

const heroProjects = featuredProjects.length > 0 ? featuredProjects : projects.slice(0, 3);
const homeCerts = featuredCertificates.length > 0 ? featuredCertificates : certificates.slice(0, 3);

const site = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Mechatronics Engineer',
  description: profile.headline,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  url: site.href,
  sameAs: Object.values(profile.socials).filter(Boolean),
};
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.shortBio}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b hairline overflow-hidden">
    <div class="wrap grid lg:grid-cols-[1.15fr_1fr] gap-x-12 gap-y-14 py-16 sm:py-24 items-center">
      <div>
        <p class="hero-step eyebrow">{profile.location} · {profile.availability}</p>
        <h1 class="hero-step display mt-4" style="font-size: var(--fs-display);">
          {profile.name}
        </h1>
        <p class="hero-step text-accent-text mono text-[0.95rem] mt-4">{profile.headline}</p>
        <p class="hero-step text-muted max-w-xl mt-6">{profile.shortBio}</p>
        <div class="hero-step flex flex-wrap gap-3 mt-9">
          <a
            href={withBase('/projects')}
            class="mono text-[0.85rem] bg-accent text-accent-ink rounded px-5 py-3 hover:opacity-90 transition-opacity duration-150"
          >
            View projects
          </a>
          {
            profile.resumeFile ? (
              <a
                href={withBase(profile.resumeFile)}
                class="mono text-[0.85rem] border border-line-strong text-text rounded px-5 py-3 hover:border-accent hover:text-accent-text transition-colors duration-150"
                target="_blank"
                rel="noopener noreferrer"
              >
                Résumé (PDF) ↗
              </a>
            ) : (
              <a
                href={withBase('/about')}
                class="mono text-[0.85rem] border border-line-strong text-text rounded px-5 py-3 hover:border-accent hover:text-accent-text transition-colors duration-150"
              >
                About me
              </a>
            )
          }
        </div>
      </div>
      <div class="hidden sm:block">
        <HeroFigure featured={heroProjects} />
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="wrap py-16 sm:py-20">
    <SectionHead
      eyebrow="Fig. 1 · detail views"
      title="Selected work"
      moreHref={withBase('/projects')}
      moreLabel="All projects"
    />
    {
      heroProjects.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {heroProjects.map((p, i) => (
            <ProjectCard project={p} eager={i === 0} />
          ))}
        </div>
      ) : (
        <EmptyState
          heading="Drafting in progress"
          message="Case studies are being written up. The full project index will appear here."
        />
      )
    }
  </section>

  <!-- Skills -->
  {
    skillGroups.length > 0 && (
      <section class="border-t hairline">
        <div class="wrap py-16 sm:py-20">
          <SectionHead eyebrow="Bill of materials" title="Skills" />
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {skillGroups.map((g) => (
              <div class="reveal">
                <h3 class="mono text-[0.8rem] text-text uppercase tracking-widest border-b hairline pb-3">
                  {g.label}
                </h3>
                <ul class="flex flex-wrap gap-1.5 mt-4">
                  {g.skills.map((s) => (
                    <li class="mono text-[0.72rem] text-muted border hairline rounded px-2 py-0.5">
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Certificates -->
  {
    homeCerts.length > 0 && (
      <section class="border-t hairline">
        <div class="wrap py-16 sm:py-20">
          <SectionHead
            eyebrow="Verified documents"
            title="Certificates"
            moreHref={withBase('/certificates')}
            moreLabel="All certificates"
          />
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {homeCerts.slice(0, 3).map((c) => (
              <CertCard cert={c} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Testimonials -->
  {
    testimonials.length > 0 && (
      <section class="border-t hairline">
        <div class="wrap py-16 sm:py-20">
          <SectionHead eyebrow="Inspection notes" title="What people say" />
          <div class="grid md:grid-cols-2 gap-6 max-w-4xl">
            {testimonials.map((t) => (
              <figure class="reveal border-l-2 border-accent pl-5 py-1">
                <blockquote class="text-[0.98rem] leading-relaxed">“{t.quote}”</blockquote>
                <figcaption class="mono text-[0.75rem] text-muted mt-4">
                  {t.link ? (
                    <a href={t.link} target="_blank" rel="noopener noreferrer" class="hover:text-text underline-offset-4 hover:underline">
                      {t.author} ↗
                    </a>
                  ) : (
                    t.author
                  )}
                  {' — '}
                  {t.title}
                  {t.organisation ? `, ${t.organisation}` : ''}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Contact CTA -->
  <section class="border-t hairline" aria-labelledby="cta-heading">
    <div class="wrap py-16 sm:py-24 text-center">
      <p class="reveal eyebrow">Next operation</p>
      <h2 id="cta-heading" class="reveal h2 mt-3 max-w-xl mx-auto">
        Building something that has to work when nobody's watching it?
      </h2>
      <div class="reveal mt-8">
        <a
          href={withBase('/contact')}
          class="mono text-[0.85rem] bg-accent text-accent-ink rounded px-6 py-3.5 inline-block hover:opacity-90 transition-opacity duration-150"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
