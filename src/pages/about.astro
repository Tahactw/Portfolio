---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, experience, education, skillGroups } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';
import { withBase, dateSpan } from '../lib/paths';

const bioHtml = renderMarkdown(profile.longBio);

const site = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Mechatronics Engineer',
  description: profile.headline,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: profile.location },
  url: new URL(withBase('/about'), site).href,
  sameAs: Object.values(profile.socials).filter(Boolean),
  alumniOf: education.map((e) => ({ '@type': 'EducationalOrganization', name: e.institution })),
};
---

<BaseLayout
  title={`About — ${profile.name}`}
  description={`${profile.headline}. ${profile.availability}.`}
  jsonLd={jsonLd}
>
  <div class="wrap py-14 sm:py-20">
    <div class="grid lg:grid-cols-[2fr_1fr] gap-x-16 gap-y-12">
      <div>
        <p class="eyebrow">Personnel record</p>
        <h1 class="h2 mt-2" style="font-size: var(--fs-h2);">About</h1>

        {/* print-only header so the printed page reads as a resume */}
        <div class="hidden print:block mt-2">
          <p class="text-[14pt] font-bold">{profile.name} — {profile.headline}</p>
          <p class="mono text-[9pt]">{profile.location} · {profile.email} · {profile.availability}</p>
        </div>

        <hr class="hairline border-t mt-6 mb-8" />
        <div class="prose" set:html={bioHtml} />

        {
          experience.length > 0 && (
            <section class="mt-14">
              <h2 class="eyebrow">Experience</h2>
              <ol class="mt-6 space-y-10 border-l hairline pl-6">
                {experience.map((e) => (
                  <li class="relative">
                    <span class="absolute -left-[1.72rem] top-1.5 w-2.5 h-2.5 rounded-full bg-accent" aria-hidden="true" />
                    <p class="mono text-[0.72rem] text-muted uppercase tracking-widest mono-nums">
                      {dateSpan(e.startDate, e.endDate)}
                    </p>
                    <h3 class="font-semibold text-[1.05rem] mt-1.5">
                      {e.role} — {e.organisation}
                    </h3>
                    {e.location && <p class="mono text-[0.75rem] text-muted mt-0.5">{e.location}</p>}
                    <p class="text-muted text-[0.95rem] mt-2">{e.description}</p>
                    {e.highlights.length > 0 && (
                      <ul class="mt-3 space-y-1.5">
                        {e.highlights.map((h) => (
                          <li class="flex gap-3 text-[0.95rem]">
                            <span class="text-accent-text mono select-none" aria-hidden="true">—</span>
                            <span>{h}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          education.length > 0 && (
            <section class="mt-14">
              <h2 class="eyebrow">Education</h2>
              <ol class="mt-6 space-y-10 border-l hairline pl-6">
                {education.map((e) => (
                  <li class="relative">
                    <span class="absolute -left-[1.72rem] top-1.5 w-2.5 h-2.5 rounded-full bg-accent" aria-hidden="true" />
                    <p class="mono text-[0.72rem] text-muted uppercase tracking-widest mono-nums">
                      {dateSpan(e.startDate, e.endDate)}
                    </p>
                    <h3 class="font-semibold text-[1.05rem] mt-1.5">
                      {e.qualification} — {e.institution}
                    </h3>
                    {e.location && <p class="mono text-[0.75rem] text-muted mt-0.5">{e.location}</p>}
                    {e.description && <p class="text-muted text-[0.95rem] mt-2">{e.description}</p>}
                    {e.coursework.length > 0 && (
                      <ul class="flex flex-wrap gap-1.5 mt-3">
                        {e.coursework.map((c) => (
                          <li class="mono text-[0.72rem] text-muted border hairline rounded px-2 py-0.5">
                            {c}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          skillGroups.length > 0 && (
            <section class="mt-14">
              <h2 class="eyebrow">Skills</h2>
              <div class="grid sm:grid-cols-2 gap-x-10 gap-y-8 mt-6">
                {skillGroups.map((g) => (
                  <div>
                    <h3 class="mono text-[0.8rem] text-text uppercase tracking-widest">{g.label}</h3>
                    <ul class="flex flex-wrap gap-1.5 mt-3">
                      {g.skills.map((s) => (
                        <li class="mono text-[0.72rem] text-muted border hairline rounded px-2 py-0.5">
                          {s}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="lg:pt-24 no-print">
        {
          profile.photo && (
            <figure class="border hairline rounded overflow-hidden mb-8">
              <img
                src={withBase(profile.photo)}
                alt={`Portrait of ${profile.name}`}
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
                class="w-full h-auto block"
              />
            </figure>
          )
        }
        <div class="border hairline rounded p-5">
          <h2 class="eyebrow">Résumé</h2>
          {
            profile.resumeFile ? (
              <div class="mt-4 space-y-3">
                <a
                  href={withBase(profile.resumeFile)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mono text-[0.85rem] bg-accent text-accent-ink rounded px-4 py-2.5 inline-block hover:opacity-90 transition-opacity duration-150"
                >
                  Open résumé (PDF) ↗
                </a>
                <p class="mono text-[0.72rem] text-muted">
                  Or print this page — it's formatted to come out as a clean one-pager.
                </p>
              </div>
            ) : (
              <p class="mono text-[0.8rem] text-muted mt-3">
                Prefer paper? Print this page — it's formatted to come out as a clean resume.
              </p>
            )
          }
          <button
            type="button"
            onclick="window.print()"
            class="mono text-[0.8rem] border border-line-strong text-text rounded px-4 py-2.5 mt-4 hover:border-accent hover:text-accent-text transition-colors duration-150"
          >
            Print this page
          </button>
        </div>
        <div class="border hairline rounded p-5 mt-6">
          <h2 class="eyebrow">Contact</h2>
          <p class="mono text-[0.8rem] mt-3">
            <a class="text-accent-text hover:underline underline-offset-4" href={`mailto:${profile.email}`}>
              {profile.email}
            </a>
          </p>
          <p class="mono text-[0.72rem] text-muted mt-2">{profile.availability}</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
