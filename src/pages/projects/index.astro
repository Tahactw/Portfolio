---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { projects, activeCategories, allProjectTags } from '../../lib/content';

const hasProjects = projects.length > 0;
---

<BaseLayout
  title="Projects — Taha Mohammed"
  description="Engineering case studies: robotics, embedded systems, control and automation projects, documented with what was built, what broke, and what was measured."
>
  <div class="wrap py-14 sm:py-20">
    <p class="eyebrow">Index of figures</p>
    <h1 class="h2 mt-2" style="font-size: var(--fs-h2);">Projects</h1>
    <p class="text-muted max-w-2xl mt-3">
      Each entry is a case study: the problem, the constraints, what was built, what broke, and
      what was measured.
    </p>
    <hr class="hairline border-t mt-6" />

    {
      hasProjects ? (
        <>
          <!-- Filter deck -->
          <form id="filter-form" class="mt-8" role="search" aria-label="Filter projects" onsubmit="return false;">
            <div class="flex flex-wrap items-center gap-3">
              <label for="project-search" class="sr-only">Search projects</label>
              <input
                id="project-search"
                type="search"
                placeholder="Search title, summary, stack…"
                autocomplete="off"
                class="mono text-[0.85rem] bg-panel border border-line-strong rounded px-3.5 py-2.5 w-full sm:w-80 text-text placeholder:text-muted"
              />
              <button
                type="button"
                id="filter-clear"
                class="mono text-[0.8rem] text-muted hover:text-text underline-offset-4 hover:underline px-2 py-2.5 hidden"
              >
                Clear filters
              </button>
            </div>

            {activeCategories.length > 1 && (
              <fieldset class="mt-5">
                <legend class="mono text-[0.68rem] text-muted uppercase tracking-widest mb-2.5">
                  Category
                </legend>
                <div class="flex flex-wrap gap-2" data-facet="category">
                  {activeCategories.map((c) => (
                    <button
                      type="button"
                      class="facet-chip"
                      data-value={c}
                      aria-pressed="false"
                    >
                      {c}
                    </button>
                  ))}
                </div>
              </fieldset>
            )}

            {allProjectTags.length > 0 && (
              <fieldset class="mt-5">
                <legend class="mono text-[0.68rem] text-muted uppercase tracking-widest mb-2.5">
                  Tags <span class="normal-case tracking-normal">(pick any)</span>
                </legend>
                <div class="flex flex-wrap gap-2" data-facet="tags">
                  {allProjectTags.map((t) => (
                    <button
                      type="button"
                      class="facet-chip"
                      data-value={t}
                      aria-pressed="false"
                    >
                      {t}
                    </button>
                  ))}
                </div>
              </fieldset>
            )}
          </form>

          <p id="filter-count" class="mono text-[0.75rem] text-muted mt-6" role="status" aria-live="polite">
            {projects.length} project{projects.length === 1 ? '' : 's'}
          </p>

          <div id="project-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">
            {projects.map((p, i) => (
              <ProjectCard project={p} eager={i < 3} headingLevel="h2" />
            ))}
          </div>

          <div id="filter-empty" class="hidden mt-10">
            <EmptyState
              heading="No matches"
              message="Nothing fits that combination of filters. Loosen one and try again."
            />
          </div>
        </>
      ) : (
        <div class="mt-12">
          <EmptyState
            heading="Drafting in progress"
            message="Case studies are being written up and will be indexed here."
          />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .facet-chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--c-muted);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    padding: 0.45rem 0.8rem;
    transition:
      color var(--dur-fast) var(--ease-settle),
      border-color var(--dur-fast) var(--ease-settle),
      background var(--dur-fast) var(--ease-settle);
  }
  .facet-chip:hover {
    color: var(--c-text);
  }
  .facet-chip[aria-pressed='true'] {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
  }
</style>

<script>
  // Client-side filtering over the server-rendered grid. State lives in the
  // URL (?q=…&cat=…&tags=a,b) so links are shareable and back/forward sane.
  const grid = document.getElementById('project-grid');
  if (grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-title]')];
    const search = document.getElementById('project-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('filter-clear');
    const count = document.getElementById('filter-count');
    const emptyBox = document.getElementById('filter-empty');
    const catChips = [...document.querySelectorAll<HTMLButtonElement>('[data-facet="category"] .facet-chip')];
    const tagChips = [...document.querySelectorAll<HTMLButtonElement>('[data-facet="tags"] .facet-chip')];

    const state = { q: '', cat: '', tags: new Set<string>() };

    function apply(pushUrl: boolean) {
      let shown = 0;
      for (const card of cards) {
        const okQ = !state.q || (card.dataset.title ?? '').includes(state.q);
        const okCat = !state.cat || card.dataset.category === state.cat;
        const cardTags = (card.dataset.tags ?? '').split('|');
        const okTags = state.tags.size === 0 || [...state.tags].every((t) => cardTags.includes(t));
        const show = okQ && okCat && okTags;
        card.classList.toggle('hidden', !show);
        if (show) shown += 1;
      }
      if (count) {
        const total = cards.length;
        count.textContent =
          shown === total ? `${total} project${total === 1 ? '' : 's'}` : `${shown} of ${total} shown`;
      }
      emptyBox?.classList.toggle('hidden', shown > 0);
      const active = !!state.q || !!state.cat || state.tags.size > 0;
      clearBtn?.classList.toggle('hidden', !active);
      for (const c of catChips) c.setAttribute('aria-pressed', String(c.dataset.value === state.cat));
      for (const c of tagChips) c.setAttribute('aria-pressed', String(state.tags.has(c.dataset.value ?? '')));

      if (pushUrl) {
        const p = new URLSearchParams();
        if (state.q) p.set('q', state.q);
        if (state.cat) p.set('cat', state.cat);
        if (state.tags.size) p.set('tags', [...state.tags].join(','));
        const qs = p.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }
    }

    function readUrl() {
      const p = new URLSearchParams(location.search);
      state.q = (p.get('q') ?? '').toLowerCase();
      state.cat = p.get('cat') ?? '';
      state.tags = new Set((p.get('tags') ?? '').split(',').filter(Boolean));
      if (search) search.value = p.get('q') ?? '';
    }

    search?.addEventListener('input', () => {
      state.q = search.value.trim().toLowerCase();
      apply(true);
    });
    for (const chip of catChips)
      chip.addEventListener('click', () => {
        state.cat = state.cat === chip.dataset.value ? '' : (chip.dataset.value ?? '');
        apply(true);
      });
    for (const chip of tagChips)
      chip.addEventListener('click', () => {
        const v = chip.dataset.value ?? '';
        if (state.tags.has(v)) state.tags.delete(v);
        else state.tags.add(v);
        apply(true);
      });
    clearBtn?.addEventListener('click', () => {
      state.q = '';
      state.cat = '';
      state.tags.clear();
      if (search) search.value = '';
      apply(true);
      search?.focus();
    });

    readUrl();
    apply(false);
  }
</script>
