---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { projects, activeCategories, allProjectTags } from '../../lib/content';

const hasProjects = projects.length > 0;
---

<BaseLayout
  title="The inventions — Taha Mohammed"
  description="Engineering case studies: robotics, embedded systems, control and automation projects, documented with what was built, what broke, and what was measured."
>
  <div class="wrap py-14 sm:py-20">
    <p class="eyebrow">The invention floor</p>
    <h1 class="h2 mt-2" style="font-size: var(--fs-h2);">The inventions</h1>
    <p class="text-muted max-w-2xl mt-3">
      Every machine on this floor has a story: the problem, the constraints, what was built,
      what broke, and what was measured. Step close to one and it wakes up.
    </p>
    <hr class="hairline border-t mt-6" />

    {
      hasProjects ? (
        <>
          <!-- Filter deck -->
          <form id="filter-form" class="mt-8" role="search" aria-label="Filter projects" onsubmit="return false;">
            <div class="flex flex-wrap items-center gap-3">
              <label for="project-search" class="sr-only">Search projects</label>
              <input
                id="project-search"
                type="search"
                placeholder="Search title, summary, stack…"
                autocomplete="off"
                class="mono text-[0.85rem] bg-panel border border-line-strong rounded px-3.5 py-2.5 w-full sm:w-80 text-text placeholder:text-muted"
              />
              <button
                type="button"
                id="filter-clear"
                class="mono text-[0.8rem] text-muted hover:text-text underline-offset-4 hover:underline px-2 py-2.5 hidden"
              >
                Clear filters
              </button>
            </div>

            {activeCategories.length > 1 && (
              <fieldset class="mt-5">
                <legend class="mono text-[0.68rem] text-muted uppercase tracking-widest mb-2.5">
                  Category
                </legend>
                <div class="flex flex-wrap gap-2" data-facet="category">
                  {activeCategories.map((c) => (
                    <button
                      type="button"
                      class="facet-chip"
                      data-value={c}
                      aria-pressed="false"
                    >
                      {c}
                    </button>
                  ))}
                </div>
              </fieldset>
            )}

            {allProjectTags.length > 0 && (
              <fieldset class="mt-5">
                <legend class="mono text-[0.68rem] text-muted uppercase tracking-widest mb-2.5">
                  Tags <span class="normal-case tracking-normal">(pick any)</span>
                </legend>
                <div class="flex flex-wrap gap-2" data-facet="tags">
                  {allProjectTags.map((t) => (
                    <button
                      type="button"
                      class="facet-chip"
                      data-value={t}
                      aria-pressed="false"
                    >
                      {t}
                    </button>
                  ))}
                </div>
              </fieldset>
            )}
          </form>

          <div class="flex flex-wrap items-center justify-between gap-3 mt-6">
            <div class="flex gap-1" role="group" aria-label="Layout">
              <button type="button" class="view-btn" data-view-btn="grid" aria-pressed="true">Grid</button>
              <button type="button" class="view-btn" data-view-btn="stagger" aria-pressed="false">Staggered</button>
              <button type="button" class="view-btn" data-view-btn="row" aria-pressed="false">Horizontal</button>
            </div>
          </div>

          <p id="filter-count" class="mono text-[0.75rem] text-muted mt-4" role="status" aria-live="polite">
            {projects.length} project{projects.length === 1 ? '' : 's'}
          </p>

          <div id="project-grid" class="mt-4" data-view="grid">
            {projects.map((p, i) => (
              <ProjectCard project={p} eager={i < 3} headingLevel="h2" />
            ))}
          </div>

          <div id="filter-empty" class="hidden mt-10">
            <EmptyState
              heading="No machine matches"
              message="Nothing on the floor fits that combination. Loosen a filter and look again."
            />
          </div>
        </>
      ) : (
        <div class="mt-12">
          <EmptyState
            heading="The floor is being set up"
            message="The first machines are still on the bench. Check back soon."
          />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .view-btn {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--c-muted);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    padding: 0.45rem 0.8rem;
    min-height: 40px;
    transition: color var(--dur-snap) var(--spring-snap), background var(--dur-snap) var(--spring-snap);
  }
  .view-btn:hover { color: var(--c-text); }
  .view-btn[aria-pressed='true'] {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
  }

  #project-grid[data-view='grid'] {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 640px) { #project-grid[data-view='grid'] { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { #project-grid[data-view='grid'] { grid-template-columns: repeat(3, 1fr); } }

  #project-grid[data-view='stagger'] {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    #project-grid[data-view='stagger'] { grid-template-columns: repeat(2, 1fr); }
    #project-grid[data-view='stagger'] > :nth-child(even):not(.hidden) { transform: translateY(2.5rem); }
    #project-grid[data-view='stagger'] { padding-bottom: 2.5rem; }
  }

  #project-grid[data-view='row'] {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: 1rem;
  }
  #project-grid[data-view='row'] > * {
    flex: 0 0 min(340px, 82vw);
    scroll-snap-align: start;
  }
  #project-grid[data-view='row']:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 4px;
  }

  .machine.is-leaving {
    opacity: 0;
    transform: scale(0.94) !important;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .facet-chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--c-muted);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    padding: 0.45rem 0.8rem;
    transition:
      color var(--dur-fast) var(--ease-settle),
      border-color var(--dur-fast) var(--ease-settle),
      background var(--dur-fast) var(--ease-settle);
  }
  .facet-chip:hover {
    color: var(--c-text);
  }
  .facet-chip[aria-pressed='true'] {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
  }
</style>

<script>
  // Client-side filtering over the server-rendered grid. State lives in the
  // URL (?q=…&cat=…&tags=a,b) so links are shareable and back/forward sane.
  function initProjectFilters() {
  const grid = document.getElementById('project-grid');
  if (grid && !grid.hasAttribute('data-wired')) {
    grid.setAttribute('data-wired', '1');
    // hoisted helpers below close over this; the narrowed const keeps them type-safe
    const gridEl: HTMLElement = grid;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-title]')];
    const search = document.getElementById('project-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('filter-clear');
    const count = document.getElementById('filter-count');
    const emptyBox = document.getElementById('filter-empty');
    const catChips = [...document.querySelectorAll<HTMLButtonElement>('[data-facet="category"] .facet-chip')];
    const tagChips = [...document.querySelectorAll<HTMLButtonElement>('[data-facet="tags"] .facet-chip')];

    const state = { q: '', cat: '', tags: new Set<string>() };
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');
    const POP = 'linear(0, 0.194 12.2%, 0.526 24.1%, 0.825 36%, 1.014 48.4%, 1.085 61.3%, 1.076 74.5%, 1.026 89.6%, 1)';

    function decide(card: HTMLElement): boolean {
      const okQ = !state.q || (card.dataset.title ?? '').includes(state.q);
      const okCat = !state.cat || card.dataset.category === state.cat;
      const cardTags = (card.dataset.tags ?? '').split('|');
      const okTags = state.tags.size === 0 || [...state.tags].every((t) => cardTags.includes(t));
      return okQ && okCat && okTags;
    }

    let flipTimer = 0;
    function apply(pushUrl: boolean) {
      const target = new Map(cards.map((c) => [c, decide(c)]));
      let shown = 0;
      for (const v of target.values()) if (v) shown += 1;

      if (REDUCED.matches) {
        for (const [card, show] of target) card.classList.toggle('hidden', !show);
      } else {
        // FLIP: departing machines power down, survivors travel, arrivals rise
        const first = new Map<HTMLElement, DOMRect>();
        for (const card of cards)
          if (!card.classList.contains('hidden')) first.set(card, card.getBoundingClientRect());
        for (const [card, show] of target)
          if (!show && !card.classList.contains('hidden')) card.classList.add('is-leaving');
        window.clearTimeout(flipTimer);
        flipTimer = window.setTimeout(() => {
          const appearing: HTMLElement[] = [];
          for (const [card, show] of target) {
            card.classList.remove('is-leaving');
            const wasHidden = card.classList.contains('hidden');
            card.classList.toggle('hidden', !show);
            if (show && wasHidden) appearing.push(card);
          }
          let moveIdx = 0;
          for (const [card, show] of target) {
            if (!show || appearing.includes(card)) continue;
            const before = first.get(card);
            if (!before) continue;
            const after = card.getBoundingClientRect();
            const dx = before.left - after.left;
            const dy = before.top - after.top;
            if (Math.abs(dx) + Math.abs(dy) < 2) continue;
            card.animate(
              [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }],
              { duration: 420, easing: POP, delay: Math.min(moveIdx * 30, 150) },
            );
            moveIdx += 1;
          }
          appearing.forEach((card, i) => {
            card.animate(
              [
                { opacity: 0, transform: 'translateY(14px) scale(0.96)' },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 420, easing: POP, delay: Math.min(i * 40, 200) },
            );
          });
        }, 170);
      }
      if (count) {
        const total = cards.length;
        count.textContent =
          shown === total ? `${total} project${total === 1 ? '' : 's'}` : `${shown} of ${total} shown`;
      }
      emptyBox?.classList.toggle('hidden', shown > 0);
      const active = !!state.q || !!state.cat || state.tags.size > 0;
      clearBtn?.classList.toggle('hidden', !active);
      for (const c of catChips) c.setAttribute('aria-pressed', String(c.dataset.value === state.cat));
      for (const c of tagChips) c.setAttribute('aria-pressed', String(state.tags.has(c.dataset.value ?? '')));

      if (pushUrl) {
        const p = new URLSearchParams();
        if (state.q) p.set('q', state.q);
        if (state.cat) p.set('cat', state.cat);
        if (state.tags.size) p.set('tags', [...state.tags].join(','));
        const qs = p.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }
    }

    function readUrl() {
      const p = new URLSearchParams(location.search);
      state.q = (p.get('q') ?? '').toLowerCase();
      state.cat = p.get('cat') ?? '';
      state.tags = new Set((p.get('tags') ?? '').split(',').filter(Boolean));
      if (search) search.value = p.get('q') ?? '';
    }

    search?.addEventListener('input', () => {
      state.q = search.value.trim().toLowerCase();
      apply(true);
    });
    for (const chip of catChips)
      chip.addEventListener('click', () => {
        state.cat = state.cat === chip.dataset.value ? '' : (chip.dataset.value ?? '');
        apply(true);
      });
    for (const chip of tagChips)
      chip.addEventListener('click', () => {
        const v = chip.dataset.value ?? '';
        if (state.tags.has(v)) state.tags.delete(v);
        else state.tags.add(v);
        apply(true);
      });
    clearBtn?.addEventListener('click', () => {
      state.q = '';
      state.cat = '';
      state.tags.clear();
      if (search) search.value = '';
      apply(true);
      search?.focus();
    });

    // view switcher: grid / staggered / horizontal, remembered per device
    const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-view-btn]')];
    function setView(v: string) {
      gridEl.setAttribute('data-view', v);
      if (v === 'row') {
        gridEl.setAttribute('tabindex', '0');
        gridEl.setAttribute('role', 'group');
        gridEl.setAttribute('aria-label', 'Projects, scrolls sideways — use arrow keys');
      } else {
        gridEl.removeAttribute('tabindex');
        gridEl.removeAttribute('role');
        gridEl.removeAttribute('aria-label');
      }
      for (const b of viewBtns) b.setAttribute('aria-pressed', String(b.dataset.viewBtn === v));
      try {
        localStorage.setItem('projects-view', v);
      } catch { /* fine */ }
    }
    for (const b of viewBtns)
      b.addEventListener('click', () => setView(b.dataset.viewBtn ?? 'grid'));
    let storedView = 'grid';
    try {
      storedView = localStorage.getItem('projects-view') ?? 'grid';
    } catch { /* fine */ }
    if (storedView !== 'grid') setView(storedView);

    readUrl();
    apply(false);
  }
  }
  document.addEventListener('astro:page-load', initProjectFilters);
</script>
