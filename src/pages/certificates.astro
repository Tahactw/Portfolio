---
import BaseLayout from '../layouts/BaseLayout.astro';
import CertCard from '../components/CertCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { certificates, certificateSkills } from '../lib/content';

/* Grouped by issuer, issuers ordered by their most recent certificate */
const groups = new Map<string, typeof certificates>();
for (const c of certificates) {
  const list = groups.get(c.issuer) ?? [];
  list.push(c);
  groups.set(c.issuer, list);
}
const issuers = [...groups.keys()];
---

<BaseLayout
  title="Certificates — Taha Mohammed"
  description="Professional certificates and completed coursework: CAD, embedded systems, control theory and robotics."
>
  <div class="wrap py-14 sm:py-20">
    <p class="eyebrow">The proving ground</p>
    <h1 class="h2 mt-2" style="font-size: var(--fs-h2);">Certificates</h1>
    <hr class="hairline border-t mt-6" />

    {
      certificates.length === 0 ? (
        <div class="mt-12">
          <EmptyState
            heading="The wall is waiting"
            message="Certificates get stamped, framed and hung here as they are earned."
          />
        </div>
      ) : (
        <>
          {certificateSkills.length > 1 && (
            <fieldset class="mt-8">
              <legend class="mono text-[0.68rem] text-muted uppercase tracking-widest mb-2.5">
                Filter by skill
              </legend>
              <div class="flex flex-wrap gap-2" id="skill-facets">
                {certificateSkills.map((s) => (
                  <button type="button" class="facet-chip" data-value={s} aria-pressed="false">
                    {s}
                  </button>
                ))}
              </div>
            </fieldset>
          )}

          <div id="cert-groups" class="mt-10 space-y-14">
            {issuers.map((issuer) => (
              <section data-issuer-group>
                <h2 class="mono text-[0.8rem] text-text uppercase tracking-widest border-b hairline pb-3">
                  {issuer}
                </h2>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
                  {(groups.get(issuer) ?? []).map((c) => (
                    <CertCard cert={c} />
                  ))}
                </div>
              </section>
            ))}
          </div>

          <div id="cert-empty" class="hidden mt-10">
            <EmptyState
              heading="No matches"
              message="No certificate covers that skill yet. Clear the filter to see everything."
            />
          </div>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  /* the wall of awards: frames hang slightly crooked; hover straightens one */
  [data-issuer-group] :global(article) {
    transition: transform var(--dur-pop) var(--spring-pop), box-shadow var(--dur-pop) var(--spring-pop);
    box-shadow: 0 8px 20px -12px var(--c-shadow);
  }
  @media (min-width: 640px) {
    [data-issuer-group] :global(article:nth-child(3n + 1)) { transform: rotate(-1.1deg); }
    [data-issuer-group] :global(article:nth-child(3n + 2)) { transform: rotate(0.9deg) translateY(6px); }
    [data-issuer-group] :global(article:nth-child(3n)) { transform: rotate(-0.5deg); }
    [data-issuer-group] :global(article:hover),
    [data-issuer-group] :global(article:focus-within) {
      transform: rotate(0deg) translateY(-4px);
      box-shadow: 0 22px 36px -16px var(--c-shadow);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-issuer-group] :global(article) { transform: none !important; transition: none; }
  }

  .facet-chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--c-muted);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    padding: 0.45rem 0.8rem;
    transition:
      color var(--dur-fast) var(--ease-settle),
      border-color var(--dur-fast) var(--ease-settle),
      background var(--dur-fast) var(--ease-settle);
  }
  .facet-chip:hover {
    color: var(--c-text);
  }
  .facet-chip[aria-pressed='true'] {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
  }
</style>

<script>
  function initCertFilters() {
  const facets = [...document.querySelectorAll<HTMLButtonElement>('#skill-facets .facet-chip:not([data-wired])')];
  facets.forEach((f) => f.setAttribute('data-wired', '1'));
  if (facets.length > 0) {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-skills]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-issuer-group]')];
    const emptyBox = document.getElementById('cert-empty');
    let active = '';

    function apply() {
      let shown = 0;
      for (const card of cards) {
        const skills = (card.dataset.skills ?? '').split('|');
        const show = !active || skills.includes(active);
        card.classList.toggle('hidden', !show);
        if (show) shown += 1;
      }
      // hide issuer groups that end up empty
      for (const g of groups) {
        const any = [...g.querySelectorAll<HTMLElement>('[data-skills]')].some(
          (c) => !c.classList.contains('hidden'),
        );
        g.classList.toggle('hidden', !any);
      }
      emptyBox?.classList.toggle('hidden', shown > 0);
      for (const f of facets) f.setAttribute('aria-pressed', String(f.dataset.value === active));
    }

    for (const f of facets)
      f.addEventListener('click', () => {
        active = active === f.dataset.value ? '' : (f.dataset.value ?? '');
        apply();
      });
  }
  }
  document.addEventListener('astro:page-load', initCertFilters);
</script>
