---
import { withBase } from '../lib/paths';

const links = [
  { href: withBase('/projects'), label: 'Projects' },
  { href: withBase('/certificates'), label: 'Certificates' },
  { href: withBase('/about'), label: 'About' },
  { href: withBase('/contact'), label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '');
  return current === h || current.startsWith(`${h}/`);
};
---

<header class="site-header border-b hairline">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
    <a
      href={withBase('/')}
      class="mono font-medium tracking-widest text-text hover:text-accent-text transition-colors duration-150"
      aria-label="Taha Mohammed — home"
    >
      TAHA<span class="text-accent">·</span>MOHAMMED
    </a>

    <div class="flex items-center gap-5">
      <nav aria-label="Main">
        <ul class="flex items-center gap-x-5 gap-y-1 flex-wrap">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={isActive(l.href) ? 'page' : undefined}
                  class:list={[
                    'mono py-2 inline-block transition-colors duration-150',
                    isActive(l.href)
                      ? 'text-accent-text'
                      : 'text-muted hover:text-text',
                  ]}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        id="theme-toggle"
        type="button"
        class="p-2.5 -m-1 border hairline rounded text-muted hover:text-text hover:border-line-strong transition-colors duration-150"
        aria-label="Switch to light theme"
      >
        <svg
          class="theme-icon-sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path>
        </svg>
        <svg
          class="theme-icon-moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* Show the icon of the theme you would switch TO */
  :global([data-theme='dark']) .theme-icon-moon {
    display: none;
  }
  :global([data-theme='light']) .theme-icon-sun {
    display: none;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const setLabel = () => {
    const cur = document.documentElement.getAttribute('data-theme');
    btn?.setAttribute(
      'aria-label',
      cur === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
    );
  };
  setLabel();
  btn?.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode: theme just won't persist */
    }
    setLabel();
  });
</script>
