{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/admin/(.*)", "dest": "admin/$1" },
    { "src": "/admin", "dest": "admin/index.html" },
    { "src": "/(css|js|shaders)/(.*)", "dest": "public/$1/$2" },
    { "src": "/(.*\\.(ico|png|jpg|svg|webp|woff2?))", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ]
}
